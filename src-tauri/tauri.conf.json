{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tree Smashers",
  "version": "../package.json",
  "identifier": "com.tree.smashers",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build-only --outDir dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Tree Smashers",
        "width": 414,
        "height": 896,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
